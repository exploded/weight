# Production flag
PROD=False

# Port the server listens on (default: 8989)
PORT=8990

# Database file path (default: weight.db)
DB_PATH=weight.db

# Shared key the scale sends as "Authorization: Bearer <key>" on POST /api/weight.
# Required: while it's empty, every reading is rejected with 503.
# Generate one in PowerShell:
#   [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
WEIGHT_API_KEY=

# Monitor portal log shipping (optional — logs WARN+ to the monitor dashboard)
MONITOR_URL=https://monitor.mchugh.au
MONITOR_API_KEY=your-api-key-here

# Discord webhook URL for new reading notifications (optional, future)
# DISCORD_WEBHOOK_URL=
